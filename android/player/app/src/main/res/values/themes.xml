<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Player" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@android:color/white</item>
    </style>
    <style name="Theme.Player.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/player_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Player</item>
    </style>
</resources>
