# Local build settings.
# Copy this file to .env and fill in real values on your own machine.
# Do not commit secrets to the repository.

# Desktop error collectors (public DSNs, selected at build time).
ROUTEVN_SENTRY_DEVELOPMENT_DSN="http://11111111111111111111111111111111@127.0.0.1:3000/system/sentry/1"
ROUTEVN_SENTRY_PRODUCTION_DSN="https://4a1f0f2f77f130fd8366487119b90a7d@api1.routevn.com/system/sentry/1"

APPLE_SIGNING_IDENTITY="Developer ID Application: Example Company, Inc. (TEAMID1234)"

# Apple notarization via Apple ID + app-specific password.
APPLE_ID="your-apple-account-email@example.com"
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
APPLE_TEAM_ID="TEAMID1234"
